# Copy to .env.local and enter the values from your Supabase project
EXPO_PUBLIC_DATA_MODE=supabase
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
# Set DATA_MODE=mock explicitly to work offline with example data

EXPO_PUBLIC_YANDEX_MAPS_API_KEY=
# Optional HTTPS gateway for this same project (also set on the EAS environment)
EXPO_PUBLIC_API_BASE_URL=
# Enable only when your Yandex Maps agreement permits persisting geocoder results
EXPO_PUBLIC_STORE_MAP_ADDRESS=false
