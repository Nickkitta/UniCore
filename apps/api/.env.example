# Скопируй в apps/api/.env и заполни. Файл .env не попадает в git.
# Полный список переменных — docs/backend-architecture.md, раздел 8.

# Порт HTTP-сервера
PORT=3000

# Подпись токенов доступа, не короче 32 символов.
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Адреса, с которых браузер может обращаться к API, через запятую (Expo web — 8081)
CORS_ORIGINS=http://localhost:8081

# false без прокси; за Caddy — адрес прокси для Express trust proxy, например uniquelocal
TRUST_PROXY=false

# Postgres, например postgres://unicore:unicore@localhost:5432/unicore — так его поднимает
# docker compose -f apps/api/docker-compose.dev.yml up -d --wait (из корня репозитория).
# Пусто — PGlite в каталоге PGLITE_DIR (путь от apps/api; memory:// — база в памяти).
# Сервер сам применяет миграции при старте. db:migrate на PGlite — только при остановленном сервере.
DATABASE_URL=
PGLITE_DIR=.local/pgdata

# Уровень логов pino: fatal, error, warn, info, debug, trace или silent.
# Логи — JSON-строки; start:dev показывает их через pino-pretty.
LOG_LEVEL=info
