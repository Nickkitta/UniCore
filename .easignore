# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local
.local/

# typescript
*.tsbuildinfo
test-results/
playwright-report/
*.log
preview/
/apps/mobile/public/connect.html
/apps/mobile/public/expo-qr.png
.idea/

# generated native folders
/apps/mobile/ios
/apps/mobile/android

# Monorepo: EAS reads this file only from the repository root and uploads the
# whole repository, so keep the server, docs and deploy files out of the archive.
# apps/mobile, packages/* and the root package.json and package-lock.json are required.
/apps/api/
/docs/
/deploy/
/vitest.config.mts

# Build only the app, never seed credentials or presentation source material
.env*
.local/
presentations/
supabase/
tests/
scripts/seed*.mjs
.agents/
.codex/
